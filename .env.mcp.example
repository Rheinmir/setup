# overstack-mcp — chép thành .env trong thư mục stack (operator viết trên host; không bao giờ commit)
#   cp .env.mcp.example .env && sed -i "s/^OVERSTACK_MCP_TOKEN=.*/OVERSTACK_MCP_TOKEN=$(openssl rand -hex 32)/" .env && chmod 600 .env

# Bearer token cho /mcp (≥ 16 ký tự). /healthz không cần token.
# Để trống / không có .env → server tự sinh token lần đầu và giữ trong volume: /workspaces/.overstack-mcp-token
# (đọc bằng `docker exec overstack-mcp cat /workspaces/.overstack-mcp-token`). Đặt ở đây khi muốn tự chọn token.
OVERSTACK_MCP_TOKEN=

# core = 11 tool chung (skill_find, tool_run, rule_check, orca_graph…) · all = thêm một tool mỗi script (146+)
OVERSTACK_TOOLS=core

# Repo mà workspace_sync được kéo (prefix URL, phân cách bằng dấu phẩy) và token read-only cho repo private
OVERSTACK_GIT_ALLOW=https://github.com/Rheinmir/
OVERSTACK_GIT_TOKEN=

# Trần thời gian một lần chạy tool (ms); tool_run có thể xin ít hơn, không hơn OVERSTACK_TOOL_MAX_TIMEOUT_MS (15 phút)
OVERSTACK_TOOL_TIMEOUT_MS=120000

# Địa chỉ host bind cổng 8791: 127.0.0.1 (mặc định) hoặc IP tailnet của host. KHÔNG dùng 0.0.0.0.
OVERSTACK_MCP_BIND=127.0.0.1

# Ref của engine orca-graph nướng vào ảnh
ORCA_GRAPH_REF=main
